{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Localization Bundle",
  "description": "Schema for a single locale translation bundle in the URPG engine.",
  "type": "object",
  "required": ["locale", "keys"],
  "properties": {
    "locale": {
      "type": "string",
      "description": "Locale code for this bundle, e.g. 'en', 'ja', 'fr'.",
      "minLength": 1
    },
    "keys": {
      "type": "object",
      "description": "Map of stable translation keys to legacy strings or structured plural and grammar variants.",
      "additionalProperties": {
        "oneOf": [
          { "type": "string" },
          {
            "type": "object",
            "minProperties": 1,
            "propertyNames": { "enum": ["zero", "one", "two", "few", "many", "other"] },
            "additionalProperties": {
              "oneOf": [
                { "type": "string" },
                {
                  "type": "object",
                  "minProperties": 1,
                  "propertyNames": { "enum": ["neutral", "masculine", "feminine", "other"] },
                  "additionalProperties": { "type": "string" }
                }
              ]
            }
          }
        ]
      }
    },
    "font_profile_id": {
      "type": "string",
      "description": "Governed font profile used for glyph coverage and shaping."
    },
    "fallback_locale": {
      "type": "string",
      "description": "Optional next locale in the bounded fallback chain."
    },
    "text_direction": {
      "type": "string",
      "enum": ["ltr", "rtl"],
      "default": "ltr"
    },
    "ime_supported": {
      "type": "boolean",
      "default": false
    },
    "source_revision": {
      "type": "integer",
      "minimum": 1,
      "default": 1
    },
    "version": {
      "type": "string",
      "description": "Optional version identifier for this bundle."
    },
    "metadata": {
      "type": "object",
      "description": "Optional metadata object for tooling or provenance."
    }
  },
  "additionalProperties": false
}
