{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://urpg.dev/schemas/dialogue_script.schema.json",
  "title": "URPG Dialogue Script",
  "type": "object",
  "required": [
    "_urpg_format_version",
    "source"
  ],
  "properties": {
    "_urpg_format_version": {
      "type": "integer",
      "const": 1
    },
    "source": {
      "type": "string",
      "description": "Canonical text-first dialogue script source."
    },
    "pages": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "diagnostics": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "line",
          "severity",
          "code",
          "message"
        ],
        "properties": {
          "line": {
            "type": "integer",
            "minimum": 1
          },
          "severity": {
            "type": "string",
            "enum": [
              "warning",
              "error"
            ]
          },
          "code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
